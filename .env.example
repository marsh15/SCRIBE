NEON_DATABASE_URL=
GOOGLE_GENERATIVE_AI_API_KEY=
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
SUPERMEMORY_API_KEY=
ENABLE_SUPERMEMORY=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

FEATURE_BILLING_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_INR=
RAZORPAY_PLAN_TEAM_INR=
RAZORPAY_MANAGE_BILLING_URL=https://dashboard.razorpay.com/app/subscriptions

FEATURE_PUBLIC_LANDING_ENABLED=true

# Scribe 2.0 Python service (T02)
INTERNAL_SERVICE_SECRET=
# Optional: override base URL for /api/py calls (defaults to https://$VERCEL_URL, then localhost:3000)
INTELLIGENCE_BASE_URL=
# Vercel protection bypass for internal calls on protected previews
VERCEL_AUTOMATION_BYPASS_SECRET=
# Python service reads DATABASE_URL, falling back to NEON_DATABASE_URL
DATABASE_URL=

# Scribe 2.0 ingestion (T12)
# legacy (default) = TypeScript extract/chunk/embed; python = POST /api/py/ingest/source
INGEST_ENGINE=legacy
# Python service: gemini (default) or fake (needs SCRIBE_ALLOW_FAKE_EMBEDDINGS=1 AND a database name containing "test")
SCRIBE_EMBEDDER=gemini
SCRIBE_ALLOW_FAKE_EMBEDDINGS=
# Seconds the ingest endpoint may spend before returning a resumable 503 (default 270)
INGEST_TIME_BUDGET_S=270

# Scribe 2.0 retrieval (T16)
# legacy (default) = TypeScript pgvector search; python = POST /api/py/retrieve with evidence labels and claim verification
RETRIEVAL_ENGINE=legacy
# Python service only: reranker for the rerank retrieval profiles (voyage|fake|none; fake/none for tests)
VOYAGE_API_KEY=
# Optional: override the chat model (default gemini-2.5-flash)
GOOGLE_CHAT_MODEL=
