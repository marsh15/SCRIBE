{
  "crons": [
    {
      "path": "/api/internal/ingest/run",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/ingest/sweep",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/py/(.*)",
      "destination": "/api/py/index"
    }
  ],
  "functions": {
    "api/py/index.py": {
      "maxDuration": 300,
      "includeFiles": "intelligence/src/**",
      "excludeFiles": "{intelligence/tests/**,intelligence/.venv/**,**/__pycache__/**,node_modules/**,.next/**,app/**,components/**,public/**}"
    }
  }
}
